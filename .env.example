# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Токен Travelpayouts (https://www.travelpayouts.com/programs/100/tools/api)
TRAVELPAYOUTS_TOKEN=
# Валюта цен: rub, kzt, usd, eur ...
CURRENCY=kzt
# Строка подключения Neon. Локально можно не задавать: будет встроенная база в ./data/pglite
DATABASE_URL=
# Любая длинная случайная строка: защищает /api/check и /api/setup (нужна на Vercel)
CRON_SECRET=
# Необязательно: список chat id через запятую, кому разрешено пользоваться ботом
ALLOWED_CHAT_IDS=
# Только локальный режим: как часто проверять цены, в минутах
CHECK_INTERVAL_MINUTES=60
