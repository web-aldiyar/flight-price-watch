{
  "name": "flight-price-watch",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram bot that watches flight prices (Aviasales / Travelpayouts) and alerts on price drops",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "build:vercel": "node deploy/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0"
  }
}
